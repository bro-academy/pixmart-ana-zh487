{% set pageClass= "productpage" %}

{% extends 'src/templates/layouts/base.twig' %}

{% block title %}
<title>{{ products.title }}</title>
<meta name="description" content="{{ products.description }}">
{% endblock %}

{% block content %}

	{% include 'src/templates/partials/page-header.twig' with {item:products.page_header} %}

	<div class="content-wrapper content-wrapper--products">

		{% include 'src/templates/partials/products-filter.twig' %}

		{% include 'src/templates/partials/products-listing.twig' %}

	</div>

{% endblock %}
