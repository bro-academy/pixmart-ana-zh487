<div class="field-default field-select">
	{% if field.label %}
	<label 
		for="{{ field.id }}"
		class="label-default"
	>
		{{ field.label }}
	</label>
	{% endif %}

	<select class="field-select__input" name="{{ field.name }}" id="{{ field.id }}">
		{% for option in field.options %}
			<option value="{{ option.value }}">{{ option.text }}</option>
		{% endfor %}
	</select>
</div>