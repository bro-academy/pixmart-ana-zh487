{% from 'ui/icon.twig' import icon %}
{% from 'ui/picture.twig' import picture %}

<div class="contacts-info">

	<p class="contacts-info__text">{{ contacts.info.description }}</p>

	<button type="button" class="contacts-info__button button button--accent button--large">{{ contacts.info.button_text }}</button>

	<ul class="contacts-info__details-list">

		{% for item in contacts.info.details %}

			<li class="contacts-info__details-item">
				{{ icon ("contacts-info__details-icon", item.icon, 24, 24) }}
				{{ item.content }}
			</li>

		{% endfor %}
	</ul>

	<div class="contacts-info__map">
    <iframe class="contacts-info__map-iframe" src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d24151.414905911966!2d-73.70632357042679!3d40.829570090592675!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sru!2s!4v1765391814341!5m2!1sru!2s" width="100%" height="314" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
		<div class="contacts-info__map-caption">
			{{ icon ("contacts-info__map-icon", contacts.info.map.caption.icon, 24, 24) }}
			<div class="contacts-info__map-info">
				<p class="contacts-info__map-name">{{ contacts.info.map.caption.name }}</p>
				<p class="contacts-info__map-address">{{ contacts.info.map.caption.address }}</p>
			</div>
		</div>
	</div>

</div>
