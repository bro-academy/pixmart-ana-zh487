{% from 'ui/icon.twig' import icon %}

<article class="plan{% if item.bestseller == "yes" %} plan--bestseller{% endif %}">
	{% if item.bestseller == "yes" %}
		<span class="plan__label">Best Seller</span>
	{% endif %}
	<header class="plan__header">
		<h3 class="plan__heading heading-xs">{{ item.name }}</h3>
		<p class="plan__price">
			<span class="plan__price-cost">{{ item.cost }}</span>
			<span class="plan__price-period">/ {{ item.period }}</span>
		</p>
	</header>
	<div class="plan__body">
		<ul class="plan__benefits">
			{% for benefit in item.benefits %}
				<li class="plan__benefits-item">
				{{ icon ("plan__benefits-icon", "check", 24, 24) }}
				{{ benefit.benefit }}</li>
			{% endfor %}
		</ul>
        <button type="button" class="button button--large {% if item.bestseller == "yes" %}button--accent{% endif %}">{{ item.button_text }}</button>
	</div>
</article>
