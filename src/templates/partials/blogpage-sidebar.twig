{% from 'ui/icon.twig' import icon %}
{% from 'ui/picture.twig' import picture %}

<aside class="blogpage-sidebar">

<h2 class="blogpage-sidebar__heading mob-hid">{{ item.heading }}</h2>

	<div class="blogpage-sidebar__info">
		<div class="blogpage-sidebar__info-block">
			<div class="blogpage-sidebar__author-avatar">
				{{ picture(
	            "blogpage-sidebar__author-img",
	            item.article_info.author_avatar,
	            item.article_info.author_name,
	            "60",
	            "60",
	            "center",
	            "cover"
                 ) }}
			</div>
		</div>
		<div class="blogpage-sidebar__info-block">
			<p class="blogpage-sidebar__author-name heading-xs">{{ item.article_info.author_name }}</p>
			<time datetime="{{ item.article_info.article_date|date('Y-m-d') }}" class="blogpage-sidebar__article-date">{{ item.article_info.article_date }}</time>
		</div>
	</div>

	<div class="blogpage-sidebar__categories">
		<h3 class="blogpage-sidebar__heading heading-xs blogpage-subheading">{{ item.categories.heading }}</h3>
		<ul class="blogpage-sidebar__categories-list">
			{% for module in item.categories.list %}
				<li class="blogpage-sidebar__categories-item">
					<a href={{ module.link }} class="blogpage-sidebar__categories-link link {% if module.active == "yes" %}blogpage-sidebar__categories-link--active{% endif %}">{{ module.text }}</a>
					{% if module.sublist %}
						<ul class="blogpage-sidebar__categories-list">
							{% for submodule in module.sublist %}
								<li class="blogpage-sidebar__categories-item">
									<a href={{ submodule.link }} class="blogpage-sidebar__categories-link link {% if submodule.active == "yes" %}blogpage-sidebar__categories-link--active{% endif %}">{{ submodule.text }}</a>
								</li>
							{% endfor %}
						</ul>
					{% endif %}
				</li>
			{% endfor %}
		</ul>
	</div>

	<div class="blogpage-sidebar__latest">
		<h3 class="blogpage-sidebar__heading heading-xs blogpage-subheading">{{ item.latest_articles.heading }}</h3>
		<ul class="blogpage-sidebar__latest-list">
			{% for module in item.latest_articles.list %}
				<li class="blogpage-sidebar__latest-item">
					<a href={{ module.link }} class="blogpage-sidebar__latest-link link">{{ module.text }}</a>
					<time datetime="{{ module.date|date('Y-m-d') }}" class="blogpage-sidebar__latest-date">{{ module.date }}</time>
				</li>
			{% endfor %}
		</ul>
	</div>

</aside>
