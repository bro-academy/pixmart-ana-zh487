<article class="service-card">
	<a href="{{ item.link }}" class="service-card__link">
		<span class="service-card__illustration">
			<svg class="service-card__icon" width="{{ item.picture_width }}" height="{{ item.picture_height }}"><use href="/src/assets/images/{{ item.picture_path }}"/></svg>
		</span>
		<h3 class="service-card__name">{{ item.name }}</h3>
	</a>
</article>
