<div class="field-radio {% if field.toggle == "yes" %}field-toggle{% endif %}">
	<input 
        type="radio" 
        id="{{ field.id }}" 
        name="{{ field.name }}" 
        value="{{ field.value }}" 
        class="field-radio__input" 
        {% if field.required == "yes" %} required {% endif %}
        {% if field.checked == "yes" %} checked {% endif %}
    />
    {% if field.label %}
	<label 
        for="{{ field.id }}" 
        class="label-default label-radio"
    >
		{{ field.label }}
	</label>
    {% endif %}
</div>