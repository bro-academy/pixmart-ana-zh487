<div class="field-default field-email">
{% if field.label %}
	<label 
        for="{{ field.id }}" 
        class="label-default"
    >
		{{ field.label }}
	</label>
{% endif %}
	<input 
        type="email" 
        id="{{ field.id }}" 
        name="{{ field.name }}" 
        placeholder="{{ field.placeholder }}" 
        class="field-email__input input-default {% if field.large == "yes" %} input-default--large {% endif %}" 
        {% if field.pattern %} pattern="{{ field.pattern }}" {% endif %} 
        {% if field.required == "yes" %} required {% endif %}
    />
</div>